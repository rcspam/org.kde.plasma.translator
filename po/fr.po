msgid "Update finished. Please restart the session."
msgstr "Mise à jour terminée. Redémarrez la session."

#: contents/ui/config/configGeneral.qml:375
msgid ""
"Update failed. Make sure that the widget is install in user's home directory."
msgstr ""
"La mise à jour a échoué. Vérifiez que le widget est installé dans votre "
"dossier personnel."

#: contents/ui/config/configGeneral.qml:426
msgid "Update"
msgstr "Mettre à jour"

